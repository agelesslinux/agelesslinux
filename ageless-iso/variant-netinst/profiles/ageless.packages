# Copied onto the netinst medium so d-i can install them without the Ageless
# archive. Everything else is fetched from the Debian mirror at install time.
ageless-os-release
ageless-agelessd
@STANCE_PACKAGES@
ageless-desktop-mate
mintmenu
mint-themes
mint-x-icons
# debian-cd reads the task definitions out of tasksel-data in the local
# mirror, so it has to be mirrored even though d-i installs it anyway.
tasksel
tasksel-data
