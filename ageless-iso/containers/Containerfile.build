# Ageless Linux ISO build environment.
# Pinned Debian trixie with every tool the pipeline needs. Contributors never
# install live-build / simple-cdd on their host; build.py runs this image.
ARG BASE_IMAGE=docker.io/library/debian:trixie-slim
FROM ${BASE_IMAGE}

ENV DEBIAN_FRONTEND=noninteractive LC_ALL=C.UTF-8

RUN arch="$(dpkg --print-architecture)" \
 && case "$arch" in \
      amd64) archpkgs="grub-efi-amd64-bin grub-pc-bin syslinux isolinux qemu-system-x86 ovmf" ;; \
      arm64) archpkgs="grub-efi-arm64-bin qemu-system-arm qemu-efi-aarch64" ;; \
    esac \
 && apt-get update \
 && apt-get install -y --no-install-recommends $archpkgs \
      live-build debootstrap mmdebstrap simple-cdd debian-cd \
      xorriso squashfs-tools mtools dosfstools cpio zstd xz-utils \
      grub-common syslinux-common syslinux-utils \
      dpkg-dev debhelper devscripts fakeroot build-essential \
      librsvg2-bin libglib2.0-bin \
      reprepro apt-utils gnupg ca-certificates curl git python3 rsync \
      qemu-utils \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /src
