# Ageless Linux release identity — the single source of truth.
# Sourced by build.py, the build-inner scripts and package builds.
AGELESS_NAME="Ageless Linux"
AGELESS_VERSION="0.1"
AGELESS_CODENAME="timeless"
# Debian base this release tracks (LMDE pattern: own codename + DEBIAN_CODENAME)
DEBIAN_SUITE="trixie"
DEBIAN_VERSION="13"
# snapshot.debian.org timestamp for reproducible builds, or "none" to use
# deb.debian.org directly. Bump deliberately; see docs/reproducibility.md.
DEBIAN_SNAPSHOT="20261001T000000Z"
