# Ageless Linux MATE defaults (vendor overrides; users can change all of it)
[org.mate.panel]
default-layout='ageless'

[org.mate.background]
picture-filename='/usr/share/backgrounds/ageless/ageless-default.png'
picture-options='zoom'
primary-color='#16161a'

[org.mate.interface]
gtk-theme='Mint-Y-Dark-Sand'
icon-theme='Mint-Y-Sand'
font-name='Noto Sans 10'
document-font-name='Noto Sans 10'
monospace-font-name='Noto Sans Mono 10'

[org.mate.Marco.general]
theme='Mint-Y-Sand'
titlebar-font='Noto Sans Bold 10'

[org.mate.caja.desktop]
font='Noto Sans 10'
home-icon-visible=true
trash-icon-visible=true

[org.mate.session]
idle-delay=15

[org.mate.screensaver]
lock-enabled=true

[com.linuxmint.mintmenu]
applet-icon='ageless-logo-symbolic'
